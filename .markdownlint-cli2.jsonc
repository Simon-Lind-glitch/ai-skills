{
  // The skills are prose meant to be read as prose; where a paragraph wraps is
  // a writing decision, not a lint finding. Everything else stays on, because
  // a skill file that renders wrong is a skill the agent reads wrong.
  "config": {
    "MD013": false
  },
  "globs": ["**/*.md"],
  // An eval prompt is the message a user types, not a document, so it has no
  // heading. The eval results are generated.
  "ignores": ["node_modules", "evals/*/prompt.md", "evals/results"]
}
